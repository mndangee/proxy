{
  "name": "proxy",
  "version": "0.3.0",
  "description": "An Electron application with React and TypeScript",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://github.com/mndangee/proxy#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mndangee/proxy.git"
  },
  "bugs": {
    "url": "https://github.com/mndangee/proxy/issues"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "apply-care-sfd": "node scripts/apply-care-sfd-to-project.mjs",
    "free-port": "node scripts/free-port.mjs",
    "reset:user-data": "node scripts/reset-all-user-data.mjs",
    "licenses": "node scripts/generate-licenses.js",
    "docs:data-guide-pdf": "npx --yes md-to-pdf docs/data-lifecycle-guide.md",
    "docs:project-overview-ppt": "node scripts/generate-project-overview-ppt.mjs",
    "docs:project-ppt": "node scripts/generate-project-presentation-ppt.mjs",
    "docs:stakeholder-ppt": "node scripts/generate-stakeholder-presentation-ppt.mjs",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "run:mac": "bash scripts/run-mac.sh",
    "run:mac:app": "bash scripts/run-mac.sh --app",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:win:arm64": "npm run build && electron-builder --win --arm64",
    "build:mac": "electron-vite build && electron-builder --mac --arm64",
    "build:mac:unsigned": "npm run build:mac:unsigned:arm64",
    "build:mac:unsigned:arm64": "electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 -c.mac.identity=null -c.mac.notarize=false -c.mac.hardenedRuntime=false",
    "build:mac:unsigned:x64": "electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --x64 -c.mac.identity=null -c.mac.notarize=false -c.mac.hardenedRuntime=false",
    "bundle:mac:unsigned": "npm run bundle:mac:unsigned:arm64",
    "bundle:mac:unsigned:arm64": "bash scripts/package-mac-unsigned-bundle.sh arm64",
    "bundle:mac:unsigned:x64": "bash scripts/package-mac-unsigned-bundle.sh x64",
    "build:mac:release": "electron-vite build && electron-builder --mac --arm64 -c.mac.notarize=true",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "adm-zip": "^0.5.17",
    "electron-updater": "^6.3.9",
    "jszip": "^3.10.1",
    "react-textarea-autosize": "^8.5.9"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "postcss": "^8.5.6",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
